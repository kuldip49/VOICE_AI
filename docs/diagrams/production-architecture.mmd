flowchart TB
  U["Customers and sales teams"] --> CDN["CDN: static React build"]
  U --> WAF["WAF + API gateway<br/>auth, rate limits, tenant routing"]
  WAF --> LB["Load balancer"]
  LB --> API1["API pods (stateless FastAPI)<br/>autoscaled on CPU / RPS"]
  LB --> WS["Realtime voice gateway<br/>WebSocket / WebRTC"]
  WS --> STT["Streaming STT service"]
  WS --> TTS["Streaming TTS service"]
  API1 --> REDIS[("Redis<br/>cache, sessions, rate limits")]
  API1 --> PG[("PostgreSQL primary<br/>tenant_id on every row, RLS")]
  PG --> PGR[("Read replicas")]
  API1 --> Q["Job queue<br/>(Celery / RQ / Cloud Tasks)"]
  Q --> W["Workers: document ingestion,<br/>embeddings, summaries, CRM sync"]
  W --> OBJ[("Object storage<br/>uploaded documents")]
  W --> VDB[("Vector DB<br/>pgvector / Qdrant")]
  API1 --> VDB
  API1 --> ROUTER["LLM router<br/>primary + fallback providers, budgets"]
  ROUTER --> LLM1["Hosted LLM API"]
  ROUTER --> LLM2["Self-hosted open model"]
  API1 --> OBS["Logs, metrics, traces<br/>OpenTelemetry, Prometheus, Grafana"]
  PG --> BK["Automated backups + PITR"]
