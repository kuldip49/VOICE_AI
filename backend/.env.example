# Copy to backend/.env and edit. Never commit the real .env file.

# --- AI provider ---------------------------------------------------------
# auto   = Grok if GROK_API_KEY is set, else Gemini, local Ollama if running, then demo mode
# demo   = no LLM; answers quote the knowledge base with clearly labelled templates
LLM_PROVIDER=auto
# xAI Grok API (set GROK_API_KEY to enable; see https://console.x.ai/)
GROK_API_KEY=
GROK_MODEL=grok-4.7
# Free key: https://aistudio.google.com/apikey  (leave empty to stay free/offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Local open-source models (free): install Ollama, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Inbound phone calls (Exotel AgentStream + Sarvam speech) --------------
# Exotel account credentials. The Voicebot applet uses API_KEY/API_TOKEN as Basic Auth.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# The Exotel phone number, in E.164 format, e.g. +919876543210.
EXOTEL_PHONE_NUMBER=
# Public TLS endpoint configured in an Exotel Voicebot applet.
EXOTEL_PUBLIC_WSS_URL=wss://voice.example.com/api/telephony/exotel/stream?sample-rate=16000
EXOTEL_SAMPLE_RATE=16000
# Sarvam realtime STT and TTS credentials/models.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE_EN=ishita
SARVAM_VOICE_HI=priya

# --- Security ------------------------------------------------------------
# When set, CRM/admin endpoints require header X-Admin-Key (enter it in Settings > Access)
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=60

# --- Database --------------------------------------------------------------
# Default: SQLite file backend/data/salespilot.db
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/salespilot
# DATABASE_URL=

TIMEZONE=Asia/Kolkata
