# Copy to backend/.env and edit. Never commit the real .env file.

# --- AI provider ---------------------------------------------------------
# auto   = Grok if GROK_API_KEY is set, else Gemini, local Ollama if running, then demo mode
# demo   = no LLM; answers quote the knowledge base with clearly labelled templates
LLM_PROVIDER=auto
# xAI Grok API (set GROK_API_KEY to enable; see https://console.x.ai/)
GROK_API_KEY=
GROK_MODEL=grok-4.7
# Free key: https://aistudio.google.com/apikey  (leave empty to stay free/offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Local open-source models (free): install Ollama, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Inbound phone calls (Twilio Programmable Voice) ----------------------
# Set this to the public HTTPS origin where FastAPI is reachable (e.g. ngrok or deployment URL).
TWILIO_PUBLIC_BASE_URL=
# Twilio Console -> Account Info -> Auth Token. Keep it only in backend/.env.
TWILIO_AUTH_TOKEN=
# Twilio's generic speech model supports English (India) and Hindi (India).
TWILIO_SPEECH_MODEL=experimental_conversations

# --- Security ------------------------------------------------------------
# When set, CRM/admin endpoints require header X-Admin-Key (enter it in Settings > Access)
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=60

# --- Database --------------------------------------------------------------
# Default: SQLite file backend/data/salespilot.db
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/salespilot
# DATABASE_URL=

TIMEZONE=Asia/Kolkata
